---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Activity, ShieldCheck, Zap, Globe2 } from "@lucide/astro";

const stats = [
  { label: "骨干网在线率", value: "99.98%", delta: "高可用", cycle: ["99.98%", "99.99%", "100%", "99.98%"] },
  { label: "单节点峰值",   value: "2.5 Gbps",  delta: "全节点×1", cycle: ["2.5 Gbps", "2.4 Gbps", "2.5 Gbps", "2.5 Gbps"] },
  { label: "全球骨干节点", value: "60+ 机房", delta: "多路冗余", cycle: ["60+ 机房", "62 节点", "65 节点", "60+ 机房"] },
  { label: "亚太平均时延", value: "28 ms",   delta: "物理专线",  cycle: ["28 ms", "26 ms", "25 ms", "29 ms"] },
];

const bars = [32, 48, 55, 78, 64, 88, 76];
const barCycles = JSON.stringify([
  [32, 48, 55, 78, 64, 88, 76],
  [45, 52, 60, 82, 70, 92, 85],
  [38, 58, 48, 75, 62, 86, 80],
  [42, 50, 68, 85, 74, 95, 88],
]);
---

<div class="relative site-container z-20 w-full mx-auto mt-12 px-4 md:mt-16 lg:mt-24 xl:px-0">
  <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-12">
    <!-- Left: Text -->
    <div class="relative w-full md:max-w-[560px] md:w-1/2 text-center sm:text-left sm:-mt-6">
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">2020 年起稳定运营</Badge>
        <Badge variant="accent">企业级 IEPL 专线 · VLESS</Badge>
      </div>

      <!-- Title -->
      <h1 class="mb-4">
        <AnimatedText
          content="专线互联 · 稳如磐石"
          delay={0.1}
          duration={0.5}
          stagger={0.08}
          class="text-4xl text-pri leading-tight md:text-5xl lg:text-6xl font-brand"
        />
      </h1>

      <!-- Subtitle -->
      <div class="mb-6">
        <AnimatedText
          content="Nexitally 专注于提供高品质 IEPL / IPLC 内网专线与现代 VLESS 协议。单节点最高 2.5Gbps 物理专线带宽，全平台自研客户端与主流第三方订阅无缝导入，无畏晚高峰拥堵，全天候保障流媒体 4K 与前沿 AI 工具极速响应。"
          delay={0.3}
          duration={0.5}
          stagger={0.012}
          class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed"
        />
      </div>

      <!-- Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="600"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url={siteConfig.registerUrl} rel="nofollow sponsored" type="fill" target="_blank" className="px-6 py-3 text-base">
          立即开通体验 <ArrowRight size={18} />
        </Button>
        <Button url="/pricing" type="solid" className="px-6 py-3 text-base">
          查看套餐详情
        </Button>
      </div>

      <!-- Tags row -->
      <div class="mt-6 flex flex-wrap items-center justify-center sm:justify-start gap-2 text-xs text-neutral-500 dark:text-neutral-400">
        <span class="inline-flex items-center gap-1"><ShieldCheck class="w-3.5 h-3.5 text-primary" /> 自研客户端</span>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span class="inline-flex items-center gap-1"><Zap class="w-3.5 h-3.5 text-primary" /> 2.5Gbps 专线</span>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span class="inline-flex items-center gap-1"><Globe2 class="w-3.5 h-3.5 text-primary" /> 不限设备</span>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span>折合 8.25 元/月起</span>
      </div>
    </div>

    <!-- Right: Product Preview (Network Console Mock) -->
    <div
      class="relative justify-end w-full mt-12 md:flex md:pl-8 md:w-1/2 md:mt-0 md:translate-y-2 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="300"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="console.nexitally.world/network" className="w-full">
        <div class="p-5 md:p-6 h-[320px] md:h-[360px] flex flex-col gap-4">
          <!-- Mock toolbar -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="hero-live-dot relative w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-200">Nexitally 核心专线拓扑</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full font-medium">全节点正常</span>
              <div class="w-6 h-1.5 rounded-full bg-neutral-200 dark:bg-neutral-700"></div>
              <div class="hero-toolbar-progress w-6 h-1.5 rounded-full bg-primary/50"></div>
            </div>
          </div>

          <!-- 2x2 Stat grid -->
          <div class="grid grid-cols-2 gap-3 flex-1">
            {stats.map((stat, i) => (
              <div class="rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 p-3 flex flex-col justify-between">
                <span class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400">{stat.label}</span>
                <div class="flex items-end justify-between">
                  <span
                    class="hero-stat-value text-lg md:text-xl font-brand text-neutral-800 dark:text-neutral-100 leading-none"
                    data-cycle={stat.cycle.join("|")}
                    style={`animation-delay: ${i * 400}ms;`}
                  >{stat.value}</span>
                  <span
                    class="hero-delta text-[10px] font-medium text-emerald-600 dark:text-emerald-400"
                    style={`animation-delay: ${i * 600}ms;`}
                  >{stat.delta}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Mini chart -->
          <div class="rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 p-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <Activity class="w-3.5 h-3.5 text-primary" />
                <span class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400">晚高峰骨干网吞吐 (Gbps)</span>
              </div>
              <span class="text-[10px] text-emerald-500 font-medium">0% 丢包率</span>
            </div>
            <div
              class="flex items-end gap-1.5 h-10 hero-bars"
              data-bar-cycles={barCycles}
            >
              {bars.map((h, i) => (
                <div
                  class:list={[
                    "hero-bar flex-1 rounded-sm origin-bottom",
                    i === bars.length - 1 ? "bg-primary hero-bar-active" : "bg-primary/25 dark:bg-primary/35",
                  ]}
                  style={`--bar-h: ${h}%; height: ${h}%; animation-delay: ${i * 90}ms;`}
                ></div>
              ))}
            </div>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>

<style>
  /* ─── Live ping dot (toolbar) ─────────────────────── */
  .hero-live-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: currentColor;
    color: rgb(16, 185, 129);
    animation: hero-live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes hero-live-ping {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%, 100% { transform: scale(3); opacity: 0; }
  }

  /* ─── Toolbar third progress pill ───────── */
  .hero-toolbar-progress {
    animation: hero-progress-cycle 3.4s ease-in-out infinite;
    transform-origin: left center;
  }
  @keyframes hero-progress-cycle {
    0%, 100% { opacity: 0.5; transform: scaleX(0.85); }
    50%      { opacity: 1;   transform: scaleX(1);    }
  }

  /* ─── Stat values ──── */
  .hero-stat-value {
    transition: opacity 200ms ease, transform 200ms ease;
    display: inline-block;
  }
  .hero-stat-value.is-flashing {
    opacity: 0.35;
    transform: translateY(2px);
  }

  /* ─── Stat delta ──────── */
  .hero-delta {
    animation: hero-delta-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hero-delta-pulse {
    0%, 100% { opacity: 1;   filter: drop-shadow(0 0 0 transparent); }
    50%      { opacity: 0.65; filter: drop-shadow(0 0 4px rgba(16, 185, 129, 0.5)); }
  }

  /* ─── Bar chart ── */
  .hero-bar {
    animation: hero-bar-rise 700ms cubic-bezier(0.4, 0, 0.2, 1) backwards;
    transition: height 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes hero-bar-rise {
    from { height: 0 !important; opacity: 0; }
    to   { opacity: 1; }
  }

  .hero-bar-active {
    animation:
      hero-bar-rise 700ms cubic-bezier(0.4, 0, 0.2, 1) backwards,
      hero-bar-glow 2.6s ease-in-out 1.2s infinite;
  }
  @keyframes hero-bar-glow {
    0%, 100% { transform: scaleY(1);    filter: brightness(1); }
    50%      { transform: scaleY(0.93); filter: brightness(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-live-dot::before,
    .hero-toolbar-progress,
    .hero-delta,
    .hero-bar,
    .hero-bar-active,
    .hero-stat-value {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Cycle stat values on a stagger (live-data feel)
  document.querySelectorAll<HTMLElement>('.hero-stat-value').forEach((el, i) => {
    const cycleAttr = el.dataset.cycle;
    if (!cycleAttr) return;
    const values = cycleAttr.split('|');
    if (values.length < 2) return;
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % values.length;
      el.classList.add('is-flashing');
      window.setTimeout(() => {
        el.textContent = values[idx];
        el.classList.remove('is-flashing');
      }, 200);
    }, 3200 + i * 700);
  });

  // Rotate bar-chart heights through predefined sets
  const heroBarsHost = document.querySelector<HTMLElement>('.hero-bars');
  const heroBars = document.querySelectorAll<HTMLElement>('.hero-bar');
  if (heroBarsHost && heroBars.length > 0) {
    try {
      const cycles = JSON.parse(heroBarsHost.dataset.barCycles || '[]') as number[][];
      if (cycles.length > 1) {
        let cycleIdx = 0;
        window.setTimeout(() => {
          window.setInterval(() => {
            cycleIdx = (cycleIdx + 1) % cycles.length;
            const next = cycles[cycleIdx];
            heroBars.forEach((b, i) => {
              if (typeof next[i] === 'number') {
                b.style.height = `${next[i]}%`;
              }
            });
          }, 2400);
        }, 1500);
      }
    } catch {
      /* swallow JSON parse errors silently */
    }
  }
</script>
