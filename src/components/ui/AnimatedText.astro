---
interface Props {
  class?: string;
  content: string | Promise<string>;
  duration?: number;
  delay?: number;
  stagger?: number;
}

let {
  content,
  duration = 0.5,
  delay = 0,
  stagger = 0.05,
  ...rest
} = Astro.props;

let processedContent = "";
if (content) {
  // @ts-expect-error
  const words = content.split(" ");
  processedContent = words
    .map(
      (word: string) =>
        `<span class="word" style="display: inline-block;">${word}</span>`,
    )
    .join(" ");
}
---

<div
  class:list={["animated-text", Astro.props.class]}
  set:html={processedContent}
  data-duration={duration}
  data-delay={delay}
  data-stagger={stagger}
  {...rest}
/>

<script>
  import { animate, stagger, inView } from "motion";

  const animatedTexts = document.querySelectorAll(".animated-text");

  animatedTexts.forEach((animatedText) => {
    const duration = parseFloat(
      animatedText.getAttribute("data-duration") || "0.5",
    );
    const delay = parseFloat(animatedText.getAttribute("data-delay") || "0");
    const dataStagger = parseFloat(
      animatedText.getAttribute("data-stagger") || "0.05",
    );

    const words = animatedText.querySelectorAll(".word");

    inView(animatedText, (element) => {
      const targetWords = element.querySelectorAll(".word");
      animate(
        targetWords,
        // @ts-expect-error
        { opacity: [0.3, 1], y: [6, 0] },
        {
          duration: duration,
          delay: stagger(dataStagger, { startDelay: delay }),
          easing: "ease-out",
        },
      );
    });
  });
</script>
