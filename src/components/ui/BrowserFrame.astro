---
interface Props {
  url?: string;
  variant?: "light" | "dark" | "auto";
  className?: string;
}

const {
  url = "nexitally.world",
  variant = "auto",
  className = "",
} = Astro.props;

const surfaceClass =
  variant === "light"
    ? "bg-bg-secondary border-primary/10"
    : variant === "dark"
    ? "bg-bg-secondary-dark border-neutral-700"
    : "bg-bg-secondary dark:bg-bg-secondary-dark border-primary/10 dark:border-neutral-700";

const chromeClass =
  variant === "light"
    ? "border-neutral-200/50 bg-neutral-50"
    : variant === "dark"
    ? "border-neutral-700/50 bg-neutral-800/50"
    : "border-neutral-200/50 dark:border-neutral-700/50 bg-neutral-50/50 dark:bg-neutral-800/50";
---

<div class={`rounded-2xl border ${surfaceClass} overflow-hidden shadow-sm ${className}`}>
  <!-- Chrome toolbar -->
  <div class={`flex items-center gap-2 px-3.5 py-2 border-b ${chromeClass}`}>
    <div class="flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
    </div>
    <div class="flex-1 flex justify-center">
      <span class="px-4 py-0.5 rounded-md bg-bg-primary/60 dark:bg-neutral-900/60 border border-neutral-200/40 dark:border-neutral-700/40 text-[11px] text-neutral-400 font-mono tracking-tight">
        {url}
      </span>
    </div>
    <div class="w-10"></div>
  </div>

  <!-- Content slot -->
  <div>
    <slot />
  </div>
</div>
