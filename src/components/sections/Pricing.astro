---
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import { siteConfig } from "@/config/site";
import { Check, ArrowRight, Sparkles, Shield, Cpu, Zap, Server, Info } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "灵活透明的专线套餐",
  description = "从轻量入门、一次性永久版到企业独立部署，满足不同场景下的高品质网络需求",
  showHeader = true,
} = Astro.props;

const plans = siteConfig.plans;
---

<section id="pricing" class="pricing-section py-8">
  {showHeader && (
    <div class="site-container pt-8 md:pt-12 text-center" data-aos="fade-up-xs" data-aos-once="true">
      <SectionHeader title={title} description={description} />
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {siteConfig.tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
            {tag}
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Pricing Cards (4-Card Grid) -->
  <div class="site-container pt-10 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {plans.map((plan, i) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${
            plan.popular
              ? "bg-bg-secondary dark:bg-bg-secondary-dark border-primary/40 shadow-lg shadow-primary/5 ring-2 ring-primary/20"
              : "bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 border-primary/15 dark:border-neutral-700 hover:border-primary/30"
          }`}
          data-aos="fade-up-xs"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          {plan.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary text-white shadow-md">
                <Sparkles class="w-3.5 h-3.5" />
                推荐热门
              </span>
            </div>
          )}

          <div>
            <!-- Header -->
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">{plan.name}</h3>
              <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full ${
                plan.popular ? "bg-primary/15 text-primary" : "bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300"
              }`}>
                {plan.badge}
              </span>
            </div>

            <!-- Price -->
            <div class="mb-4">
              <div class="flex items-baseline gap-1">
                <span class="text-sm font-semibold text-neutral-600 dark:text-neutral-400">¥</span>
                <span class="text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-50">{plan.price}</span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400">{plan.period}</span>
              </div>
              {plan.note && (
                <p class="text-[11px] text-amber-600 dark:text-amber-400 mt-1 leading-tight flex items-start gap-1">
                  <Info class="w-3 h-3 flex-shrink-0 mt-0.5" />
                  <span>{plan.note}</span>
                </p>
              )}
            </div>

            <!-- Key Parameters Quick Box -->
            <div class="p-3 mb-5 rounded-xl bg-bg-primary dark:bg-neutral-900/60 border border-primary/10 dark:border-neutral-800 text-xs space-y-1.5">
              <div class="flex justify-between items-center text-neutral-700 dark:text-neutral-300">
                <span class="text-neutral-500">可用流量</span>
                <span class="font-semibold text-primary">{plan.traffic}</span>
              </div>
              <div class="flex justify-between items-center text-neutral-700 dark:text-neutral-300">
                <span class="text-neutral-500">线路架构</span>
                <span class="font-medium truncate max-w-[130px]" title={plan.line}>{plan.line}</span>
              </div>
              <div class="flex justify-between items-center text-neutral-700 dark:text-neutral-300">
                <span class="text-neutral-500">在线设备</span>
                <span class="font-medium text-emerald-600 dark:text-emerald-400">{plan.devices}</span>
              </div>
              {plan.discount && (
                <div class="flex justify-between items-center text-neutral-700 dark:text-neutral-300">
                  <span class="text-neutral-500">优惠政策</span>
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">{plan.discount}</span>
                </div>
              )}
            </div>

            <!-- Feature List -->
            <ul class="space-y-2.5 mb-6 text-xs text-neutral-600 dark:text-neutral-300">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2">
                  <div class="w-4 h-4 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <Check class="w-2.5 h-2.5" stroke-width={3} />
                  </div>
                  <span class="leading-relaxed">{f.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Action Button -->
          <div class="pt-2">
            <Button
              url={siteConfig.registerUrl}
              rel="nofollow sponsored"
              target="_blank"
              type={plan.popular ? "fill" : "solid"}
              className="w-full justify-center text-sm py-2.5 font-medium"
            >
              {plan.cta} <ArrowRight class="w-3.5 h-3.5 ml-1" />
            </Button>
          </div>
        </div>
      ))}
    </div>

    <!-- Technical Specs & Notice Strip -->
    <div class="mt-12 max-w-5xl mx-auto rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700 p-6 md:p-8" data-aos="fade-up-xs" data-aos-once="true">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <Server class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">企业级 IEPL 专线架构</h4>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              全节点最高 2.5Gbps 带宽，物理专线出海不过公网阻断，晚高峰零拥堵稳定低时延。
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <Cpu class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">现代化 VLESS 协议</h4>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              轻量原生低开销，抗封锁抗抖动，专为长效稳定的 AI 交互与流媒体推流优化。
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <Shield class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">全平台客户端生态</h4>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              提供 Windows / macOS / Android / iOS 自研客户端，支持 Clash、Shadowrocket 等一键导入。
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 gap-2">
        <div class="flex items-center gap-1.5">
          <Info class="w-4 h-4 text-primary flex-shrink-0" />
          <span>8.25 元/月为年付套餐折算后平均月成本；流媒体与 AI 工具可用性以节点实际测试为准。</span>
        </div>
        <a href={siteConfig.registerUrl} target="_blank" rel="nofollow sponsored" class="text-primary hover:underline font-medium flex-shrink-0">
          前往官方授权开通页 &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
