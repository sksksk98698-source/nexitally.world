---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig, socialLinks } from "@/config/site.js";

const currentYear = new Date().getFullYear();

const footerLinks = {
  product: [
    { name: "官网首页", url: "/" },
    { name: "套餐资费", url: "/pricing" },
    { name: "专线技术", url: "/features" },
    { name: "官方注册", url: siteConfig.registerUrl, external: true },
    { name: "客户登录", url: "/sign-in" },
  ],
  resources: [
    { name: "使用教程", url: "/blog" },
    { name: "客户端下载", url: "/blog/client-setup-guide" },
    { name: "服务状态监控", url: "/status" },
    { name: "常见问题 FAQ", url: "/#faq" },
  ],
  company: [
    { name: "关于我们", url: "/about" },
    { name: "联系客服", url: "/contact" },
  ],
  legal: [
    { name: "服务条款 (TOS)", url: "/terms" },
    { name: "隐私政策", url: "/privacy" },
    { name: "官方授权声明", url: "/about#authorization" },
  ],
};
---

<footer class="text-gray-700 border-t mt-16 md:mt-24 border-dashed border-primary/15 dark:border-primary-dark/15 border-[.75px]">
  <div class="container mx-auto px-7 max-w-7xl py-12 md:py-16">
    <!-- Top: Logo + Description -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 mb-12">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-xs md:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
          Nexitally 自 2020 年稳定运营至今，专注高可用企业级 IEPL / IPLC 专线架构与现代 VLESS 协议。提供全平台自研客户端与第三方订阅无缝导入，全节点最高 2.5Gbps，轻松应对晚高峰与高要求跨境业务。
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            全节点物理专线正常运行
          </span>
        </div>
      </div>

      <!-- Four columns -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-12">
        <!-- Product -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 mb-4">产品服务</h4>
          <ul class="space-y-2.5">
            {footerLinks.product.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "nofollow sponsored" : undefined}
                  class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 mb-4">技术资源</h4>
          <ul class="space-y-2.5">
            {footerLinks.resources.map((link) => (
              <li>
                <a href={link.url} class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 mb-4">品牌支持</h4>
          <ul class="space-y-2.5">
            {footerLinks.company.map((link) => (
              <li>
                <a href={link.url} class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 mb-4">合规与条款</h4>
          <ul class="space-y-2.5">
            {footerLinks.legal.map((link) => (
              <li>
                <a href={link.url} class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-dashed border-primary/10 dark:border-primary-dark/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400 dark:text-neutral-500">
      <p>
        © 2020 - {currentYear} {siteConfig.title} (nexitally.world). 本网站为品牌官方授权落地页。
      </p>

      <div class="flex items-center gap-4">
        <span>域名：nexitally.world</span>
        <span>·</span>
        <span>IEPL / IPLC 专线</span>
        <span>·</span>
        <span>VLESS 协议</span>
      </div>
    </div>
  </div>
  <ToTop />
</footer>
