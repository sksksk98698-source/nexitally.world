---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import { getCollection, render } from "astro:content";
import Badge from "@/components/ui/Badge.astro";

const allEntries = await getCollection("changelog");
const entries = allEntries.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="网络更新日志 — Nexitally 官方网站"
  description="实时跟踪 Nexitally 专线网络扩容、客户端升级与节点部署最新进展。"
>
  <section class="site-container my-12">
    <PageHeader
      title="网络更新与维护日志"
      description="实时记录 Nexitally 核心骨干专线建设、客户端迭代与基础设施扩容历程。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <div class="relative border-l-2 border-primary/20 dark:border-neutral-700 ml-4 pl-8 space-y-12">
      {
        entries.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <article class="relative group" data-aos="fade-up-xs" data-aos-once="true">
              {/* Timeline dot */}
              <div class="absolute -left-[41px] top-1.5 w-4 h-4 rounded-full border-2 border-bg-primary dark:border-bg-primary-dark bg-primary group-hover:scale-125 transition-transform duration-200" />

              {/* Version & Date */}
              <div class="flex items-center gap-3 mb-2">
                {entry.data.version && (
                  <Badge variant="primary">{entry.data.version}</Badge>
                )}
                <time
                  datetime={entry.data.publishDate.toISOString()}
                  class="text-xs text-neutral-400 dark:text-neutral-500"
                >
                  {formatDate(entry.data.publishDate)}
                </time>
              </div>

              {/* Title */}
              <h2 class="text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-3">
                {entry.data.title}
              </h2>

              {/* Content */}
              <div class="prose dark:prose-invert text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                <Content />
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>
