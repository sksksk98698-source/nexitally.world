---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import PricingSection from "@/components/sections/Pricing.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { Check, X, ArrowRight, ShieldCheck, Sparkles, HelpCircle, BookOpen } from "@lucide/astro";

const comparisonFeatures = [
  { name: "流量规格", snooker: "247GB (永久不过期)", light: "69GB / 月", speed: "168GB / 月", custom: "500GB / 月 (可弹性扩容)" },
  { name: "线路类型", snooker: "原生稳定专线", light: "原生稳定专线", speed: "全球物理 IPLC 专线", custom: "专属独立 IPLC 专线" },
  { name: "节点倍率", snooker: "全节点 1x", light: "全节点 1x", speed: "全节点 1x", custom: "独享带宽 / 独立原生 IP" },
  { name: "单节点峰值速率", snooker: "最高 2.5 Gbps", light: "原生专线速率", speed: "最高 2.5 Gbps", custom: "最高 2.5 Gbps (独立通道)" },
  { name: "同时连接设备", snooker: "不限设备数量", light: "不限设备数量", speed: "不限设备数量", custom: "不限客户端数量" },
  { name: "覆盖主要国家地区", snooker: "港/台/日/新/美/马/欧等", light: "港/台/日/新/马/美/欧等", speed: "港/台/日/新/马/美/欧等", custom: "全球核心机房按需指定部署" },
  { name: "ChatGPT / AI 工具", snooker: "深度支持", light: "常规支持", speed: "极速低时延支持", custom: "企业级高可用专属通道" },
  { name: "Netflix / Disney+ 4K", snooker: "支持", light: "支持", speed: "4K 极速秒开", custom: "定制化原生 IP 广播" },
  { name: "TikTok 直播与跨境电商", snooker: "支持", light: "轻度支持", speed: "稳定支持", custom: "专属独享 IP 极稳推流" },
  { name: "客户端支持", snooker: "自研客户端 + Clash/小火箭", light: "自研客户端 + Clash/小火箭", speed: "自研客户端 + Clash/小火箭", custom: "全生态客户端 + 专人配置" },
  { name: "服务运维保障", snooker: "工单客服", light: "日常运维", speed: "7×24 小时实时监控", custom: "7×24 小时 1 对 1 专属工程师" },
  { name: "周期与折扣", snooker: "一次性付清（不打折）", light: "年付 99 元（约 8.25/月）", speed: "半年9折 / 年付8折 / 三年7折", custom: "按月续费（不打折）" },
];

const pricingFaq = [
  {
    question: "8.25 元/月是如何计算的？",
    answer: "8.25 元/月是『轻量版』年付套餐（99 元/年）折算后的平均月度成本，方便用户直观对比性价比，并不是单独的普通月付价格。如需月付，推荐选择 25 元/月的『极速版』全 IPLC 专线套餐。"
  },
  {
    question: "致敬斯诺克 147 永久套餐的有效期是多久？",
    answer: "永久套餐包含 247GB 高速流量，不设时间过期限制，用完为止。非常适合日常查阅资料、邮件往来、轻度浏览或出差备用的用户，彻底解决传统月付套餐未使用流量被清零的痛点。"
  },
  {
    question: "套餐是否限制在线客户端或设备数量？",
    answer: "Nexitally 全系套餐均不限制设备数量。无论您的手机、平板、笔记本或台式机，只要在您个人合理自用范围内，均可同时登录使用。"
  },
  {
    question: "如何使用客户端？支持哪些第三方软件？",
    answer: "我们提供 Windows / macOS / Android / iOS 官方自研客户端，开箱即用无需复杂配置；同时全面支持 Clash、Shadowrocket（小火箭）、Surge、v2rayN 等第三方流行客户端的订阅导入。欢迎参阅我们的《客户端安装与订阅导入速成指南》（/blog/client-setup-guide/）了解完整图文步骤。"
  },
  {
    question: "IPLC 与普通公网中转相比到底好在哪里？",
    answer: "IPLC（国际专线）直接走跨国内网物理光纤，不经过国际公网出口路由，从物理层面上杜绝晚高峰拥堵、QoS 丢包与防火墙主动干扰。详细技术对比请见《IEPL 与 IPLC 跨境专线网络架构深度解析》（/blog/iepl-network-architecture/）。"
  },
  {
    question: "定制版套餐如何办理开通？",
    answer: "定制版专为跨境电商团队、海外直播工作室与企业跨国协作量身打造。注册进入官网控制台后，可直接联系专属客服，确认您需要的指定地区原生 IP、独立带宽与线路走向，由工程师为您独立部署。"
  }
];
const pricingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": pricingFaq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Nexitally 跨境物理专线加速服务",
  "image": `${siteConfig.url}/assets/logo.png`,
  "description": "企业级 IEPL / IPLC 物理专线与 VLESS 协议跨境网络加速，不限设备，单节点最高 2.5Gbps。",
  "brand": {
    "@type": "Brand",
    "name": "Nexitally"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "致敬斯诺克 147 永久套餐",
      "price": "147.00",
      "priceCurrency": "CNY",
      "availability": "https://schema.org/InStock",
      "url": `${siteConfig.url}/pricing/`
    },
    {
      "@type": "Offer",
      "name": "轻量版年付套餐",
      "price": "99.00",
      "priceCurrency": "CNY",
      "availability": "https://schema.org/InStock",
      "url": `${siteConfig.url}/pricing/`
    },
    {
      "@type": "Offer",
      "name": "极速版 IPLC 月付套餐",
      "price": "25.00",
      "priceCurrency": "CNY",
      "availability": "https://schema.org/InStock",
      "url": `${siteConfig.url}/pricing/`
    },
    {
      "@type": "Offer",
      "name": "企业定制专线套餐",
      "price": "680.00",
      "priceCurrency": "CNY",
      "availability": "https://schema.org/InStock",
      "url": `${siteConfig.url}/pricing/`
    }
  ]
};

const pricingSchemas = [pricingFaqSchema, productSchema];
---

<Layout
  title="套餐资费 — Nexitally 官方网站"
  description="Nexitally 专线套餐详情：致敬斯诺克147永久套餐、轻量版、极速版 IPLC、企业定制版。透明公开、不限设备、全节点1倍率。"
  keywords="Nexitally套餐, Nexitally价格, 斯诺克147永久套餐, IPLC专线套餐, 跨境电商专线, 机场年付"
  schema={pricingSchemas}
>
  <section class="site-container my-10">
    <PageHeader
      title="透明公开的专线套餐体系"
      description="无隐形倍率消费，真实专线带宽。选择最契合您当前业务与使用习惯的专线方案。"
    />
  </section>

  <!-- Pricing Cards -->
  <PricingSection showHeader={false} />

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- Feature Comparison Table -->
  <section class="site-container py-12 md:py-16" data-aos="fade-up-xs" data-aos-once="true">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl md:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100">套餐规格横向对比</h2>
      <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mt-2">清晰对比各版本硬件线路资源与支持场景，助您快速决策</p>
    </div>

    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-primary/15 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark p-4 md:p-6 shadow-sm">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead>
          <tr class="border-b border-dashed border-neutral-200 dark:border-neutral-700">
            <th class="py-3.5 pr-4 text-xs font-semibold text-neutral-500 uppercase tracking-wider">特性指标</th>
            <th class="py-3.5 px-3 text-center text-xs font-semibold text-neutral-700 dark:text-neutral-300">致敬 147 永久版</th>
            <th class="py-3.5 px-3 text-center text-xs font-semibold text-neutral-700 dark:text-neutral-300">轻量版</th>
            <th class="py-3.5 px-3 text-center text-xs font-semibold text-primary">极速版 (IPLC)</th>
            <th class="py-3.5 px-3 text-center text-xs font-semibold text-neutral-700 dark:text-neutral-300">企业定制版</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {comparisonFeatures.map((row) => (
            <tr class="hover:bg-primary/5 transition-colors">
              <td class="py-3.5 pr-4 text-xs font-medium text-neutral-800 dark:text-neutral-200">{row.name}</td>
              <td class="py-3.5 px-3 text-center text-xs text-neutral-600 dark:text-neutral-400">{row.snooker}</td>
              <td class="py-3.5 px-3 text-center text-xs text-neutral-600 dark:text-neutral-400">{row.light}</td>
              <td class="py-3.5 px-3 text-center text-xs font-medium text-primary">{row.speed}</td>
              <td class="py-3.5 px-3 text-center text-xs text-neutral-600 dark:text-neutral-400">{row.custom}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Related Knowledge Links -->
    <div class="max-w-5xl mx-auto mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/blog/iepl-network-architecture/" class="p-4 rounded-xl border border-primary/10 bg-bg-secondary/50 hover:border-primary/30 transition-all flex items-center justify-between text-xs group">
        <div>
          <span class="block text-neutral-400">底层技术</span>
          <strong class="text-neutral-800 dark:text-neutral-100 group-hover:text-primary">IEPL/IPLC 物理专线架构原理解析</strong>
        </div>
        <ArrowRight class="w-4 h-4 text-primary shrink-0 ml-2" />
      </a>
      <a href="/blog/vless-protocol-advantages/" class="p-4 rounded-xl border border-primary/10 bg-bg-secondary/50 hover:border-primary/30 transition-all flex items-center justify-between text-xs group">
        <div>
          <span class="block text-neutral-400">协议优势</span>
          <strong class="text-neutral-800 dark:text-neutral-100 group-hover:text-primary">现代化 VLESS 协议性能对比</strong>
        </div>
        <ArrowRight class="w-4 h-4 text-primary shrink-0 ml-2" />
      </a>
      <a href="/blog/ai-and-streaming-unlock/" class="p-4 rounded-xl border border-primary/10 bg-bg-secondary/50 hover:border-primary/30 transition-all flex items-center justify-between text-xs group">
        <div>
          <span class="block text-neutral-400">业务场景</span>
          <strong class="text-neutral-800 dark:text-neutral-100 group-hover:text-primary">ChatGPT 与 4K 流媒体解锁实测</strong>
        </div>
        <ArrowRight class="w-4 h-4 text-primary shrink-0 ml-2" />
      </a>
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- Pricing FAQ -->
  <section class="py-12 md:py-16 site-container">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl md:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100">套餐常见疑问</h2>
      <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mt-2">关于计费方式、设备规则与使用条款的真实解答</p>
    </div>
    <div class="max-w-3xl mx-auto" data-aos="fade-up-xs" data-aos-once="true">
      {pricingFaq.map((item, index) => (
        <AccordionItem question={item.question} answer={item.answer} index={index} />
      ))}
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-12 md:py-16 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-3xl mx-auto text-center p-8 md:p-12 rounded-2xl bg-gradient-to-b from-primary/10 to-transparent border border-primary/20">
      <h3 class="text-2xl md:text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-50 mb-3">准备好体验稳定低延迟了吗？</h3>
      <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-6 max-w-xl mx-auto">
        点击下方按钮直达 Nexitally 官方授权注册门户，完成开通即可立即导入节点。
      </p>
      <div class="flex justify-center">
        <Button url={siteConfig.registerUrl} rel="nofollow sponsored" target="_blank" type="fill" className="px-8 py-3 text-base">
          立即开通账号 <ArrowRight class="w-4 h-4 ml-1.5" />
        </Button>
      </div>
    </div>
  </section>
</Layout>
