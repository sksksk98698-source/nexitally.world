---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout
  title="使用教程与专线知识库 — Nexitally 官方网站"
  description="Nexitally 官方专线使用指南、客户端配置教程、IEPL 与 VLESS 协议技术深度解析。"
  keywords="Nexitally教程, 客户端配置指南, VLESS订阅导入, IEPL专线解析"
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="专线技术与使用指南"
      description="涵盖官方客户端安装、第三方订阅导入、IEPL 专线架构与流媒体解锁实践。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-8">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
