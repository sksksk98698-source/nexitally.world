---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import {
  ShieldCheck, Zap, Globe2, Cpu, CheckCircle2,
  Lock, ArrowRight, Laptop, Smartphone, Monitor,
  Wifi, HelpCircle, Layers, Server, Activity,
  Bot, ShoppingBag, Video, Clapperboard, BookOpen
} from "@lucide/astro";

// FAQ data
const faqItems = [
  {
    question: "Nexitally 的专线架构相比普通公网中转有什么区别？",
    answer: "Nexitally 核心骨干采用企业级物理 IEPL / IPLC 专线连接，数据通过海底光缆与内网点对点直连，绕过公网防火墙与晚高峰公网拥堵路由。无论是在晚间网络高峰期还是国际公网波动时，都能提供近乎零丢包的极低时延体验。"
  },
  {
    question: "什么是 8.25 元/月的价格？",
    answer: "8.25 元/月为『轻量版』年付套餐（99 元/年）折算后的平均月度成本，方便用户直观感受长期订阅的高性价比，并非单独的普通单月购买价格。如果您需要灵活月付，推荐选择 25 元/月包含全球 IPLC 物理专线的『极速版』套餐。"
  },
  {
    question: "致敬斯诺克 147 永久套餐适合什么人群？",
    answer: "该套餐包含 247GB 永久有效高速流量，一次性付费永不过期。特别适合不经常重度下载、主要用于日常查阅资料、邮件收发、偶尔出差或作为备用线路的用户，彻底告别按月清零的流量浪费。"
  },
  {
    question: "套餐是否限制在线设备数量？",
    answer: "全系套餐均不限制设备数量。个人手机、笔记本、平板、家庭办公设备等只要在合理自用范围内，均支持多端同时在线连接，无需额外购买设备许可。"
  },
  {
    question: "自研客户端与 Clash / Shadowrocket 有什么不同？",
    answer: "Nexitally 自研客户端专为本站专线网络深度定制，内置节点自动测速、智能分流与一键故障自愈，开箱即用无需手动编辑配置规则；同时，我们完整保留第三方客户端订阅接口，资深玩家依然可以使用 Clash、Shadowrocket 等工具随心导入。"
  },
  {
    question: "支持哪些流媒体与 AI 工具？",
    answer: "全线节点深度覆盖主流海外流媒体（如 Netflix、Disney+、YouTube Premium）与前沿 AI 生产力工具（如 ChatGPT、Claude、Midjourney）。具体解锁状态受第三方平台策略动态影响，建议在控制台参考节点状态与实时说明。"
  }
];

// Core Value Advantages
const coreAdvantages = [
  {
    icon: Server,
    title: "企业级 IEPL / IPLC 专线",
    desc: "骨干网点对点物理内网专线直连，晚高峰公网风暴无影响，单节点峰值最高可达 2.5Gbps。",
    link: "/blog/iepl-network-architecture/",
    linkText: "IEPL 专线网络架构解析 →"
  },
  {
    icon: Cpu,
    title: "现代高效 VLESS 协议",
    desc: "轻量化握手与低资源开销，原生抗干扰抗阻断能力更强，长时间保持 TCP/UDP 传输稳定。",
    link: "/blog/vless-protocol-advantages/",
    linkText: "VLESS 协议深度技术解析 →"
  },
  {
    icon: Laptop,
    title: "全平台自研 + 第三方生态",
    desc: "提供专属 Windows / Mac / iOS / Android 客户端；全面兼容 Clash、Shadowrocket 订阅无缝导入。",
    link: "/blog/client-setup-guide/",
    linkText: "多客户端配置实战教程 →"
  },
  {
    icon: ShieldCheck,
    title: "2020 年起稳定运营口碑",
    desc: "多年持续深耕高可用跨境网络基础设施，不搞虚假吹嘘与营销套路，服务持续可靠。",
    link: "/about/",
    linkText: "了解品牌历程与授权说明 →"
  },
  {
    icon: Zap,
    title: "全节点 1 倍率公平计费",
    desc: "无隐形扣费与高倍率套路，用多少算多少。提供一次性永久套餐与高性价比年付折算。",
    link: "/pricing/",
    linkText: "查看完整透明套餐资费 →"
  },
  {
    icon: Globe2,
    title: "AI 与流媒体原生优化",
    desc: "住宅/机房原生 IP 策略分流，ChatGPT、Claude、Netflix 4K HDR 极速秒开与长会话稳定连接。",
    link: "/blog/ai-and-streaming-unlock/",
    linkText: "AI 与流媒体解锁深度指南 →"
  }
];

// Workflow Steps
const steps = [
  {
    step: "01",
    title: "注册官方账号",
    desc: "通过官方授权注册门户，快速完成账户注册并登录管理控制台。"
  },
  {
    step: "02",
    title: "选择专线套餐",
    desc: "按需选购轻量版、致敬 147 永久版、极速 IPLC 版或企业定制专线。"
  },
  {
    step: "03",
    title: "下载或导入订阅",
    desc: "下载 Nexitally 官方客户端，或导入 Clash / 小火箭。",
    guideLink: "/blog/client-setup-guide/",
    guideText: "图文配置速成指南"
  },
  {
    step: "04",
    title: "一键高速互联",
    desc: "开启智能分流，即刻畅享 4K 流媒体、低延迟 AI 交互与跨国无缝办公。"
  }
];

// Node coverage groups
const nodeGroups = [
  { region: "香港核心机房", count: "20+ 节点", latency: "< 25ms", desc: "晚高峰专线主力，低时延高并发", tag: "IEPL 专线" },
  { region: "日本骨干网络", count: "10+ 节点", latency: "< 45ms", desc: "东京/大阪优质机房，4K 流媒体极速秒开", tag: "原生解锁" },
  { region: "新加坡核心", count: "10+ 节点", latency: "< 55ms", desc: "东南亚中继枢纽，TikTok 业务低延时", tag: "亚太枢纽" },
  { region: "美国核心节点", count: "10+ 节点", latency: "< 140ms", desc: "西海岸/东海岸双向冗余，AI 工具与开发首选", tag: "原生住宅/机房" },
  { region: "台湾本地专线", count: "5+ 节点", latency: "< 35ms", desc: "原生流媒体与繁体本地化业务专线", tag: "流媒体解锁" },
  { region: "欧洲及全球多国", count: "10+ 节点", latency: "专线直连", desc: "英、德、法、土耳其、马来西亚、泰国、巴西等", tag: "全球漫游" },
];

// Real Use Cases
const useCases = [
  {
    icon: Bot,
    title: "AI 工具大模型协同",
    desc: "ChatGPT、Claude、Midjourney 等深度适配，长会话不中断，低延迟交互。",
    link: "/blog/ai-and-streaming-unlock/",
    tag: "AI 节点解锁策略"
  },
  {
    icon: Clapperboard,
    title: "4K HDR 海外流媒体",
    desc: "超大带宽支持 Netflix、Disney+、YouTube Premium 原生清晰度播放无卡顿。",
    link: "/blog/ai-and-streaming-unlock/",
    tag: "流媒体分流实测"
  },
  {
    icon: ShoppingBag,
    title: "跨境电商多店铺运营",
    desc: "Amazon、Shopify、eBay 等卖家后台稳定登录，隔离公网干扰，安全可靠。",
    link: "/pricing/",
    tag: "企业定制专属通道"
  },
  {
    icon: Video,
    title: "TikTok 直播与海外社媒",
    desc: "海外版抖音推流不掉帧，海外社媒广告投放、私信运营全天候稳定在线。",
    link: "/blog/iepl-network-architecture/",
    tag: "物理专线低抖动"
  },
  {
    icon: Laptop,
    title: "跨国远程办公与开发",
    desc: "GitHub、Slack、Zoom、Google Workspace 快速协同，代码拉取丝滑顺畅。",
    link: "/blog/vless-protocol-advantages/",
    tag: "VLESS 低开销加速"
  },
  {
    icon: BookOpen,
    title: "学术检索与海外文献",
    desc: "Google Scholar、IEEE、Nature 等海外学术资料库快速访问，科研必备。",
    link: "/pricing/",
    tag: "致敬 147 永久套餐推荐"
  }
];

// FAQ Schema for GEO & SERP Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title={siteConfig.meta.title}
  description={siteConfig.meta.description}
  keywords={siteConfig.meta.keywords}
  schema={faqSchema}
>

  <!-- 1. Hero Section -->
  <HeroSection />

  <!-- 2. Trust Strip -->
  <section class="py-8 md:py-12 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="rounded-2xl border border-primary/10 dark:border-neutral-800 bg-bg-secondary/60 dark:bg-bg-secondary-dark/60 p-6 md:p-8 backdrop-blur">
      <div class="text-center mb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
          企业级可靠性 · 专为苛刻网络需求而生
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">2020 年</span>
          <span class="text-xs text-neutral-500">稳定运营至今</span>
        </div>
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">IEPL 专线</span>
          <span class="text-xs text-neutral-500">内网物理直连</span>
        </div>
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">VLESS</span>
          <span class="text-xs text-neutral-500">轻量低耗协议</span>
        </div>
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">2.5 Gbps</span>
          <span class="text-xs text-neutral-500">单节点峰值速率</span>
        </div>
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">不限设备</span>
          <span class="text-xs text-neutral-500">多端同时连接</span>
        </div>
        <div class="p-3 rounded-xl bg-bg-primary/50 dark:bg-neutral-900/40 border border-primary/5">
          <span class="block text-lg md:text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100">自研客户端</span>
          <span class="text-xs text-neutral-500">全平台无缝支持</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Core Advantages (Features Grid with Backlinks) -->
  <section class="py-12 md:py-20 site-container">
    <SectionHeader
      title="卓越架构 · 专线与协议的极致体验"
      description="拒绝廉价公网中转与虚标倍率，以扎实的基础设施打造值得托付的长效网络服务"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {coreAdvantages.map((adv, i) => (
        <div
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
          class="h-full"
        >
          <div class="h-full p-6 md:p-7 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 hover:border-primary/30 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5">
                <adv.icon class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-2">{adv.title}</h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4">{adv.desc}</p>
            </div>
            {adv.link && (
              <div class="pt-3 border-t border-dashed border-neutral-100 dark:border-neutral-800">
                <a
                  href={adv.link}
                  class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
                >
                  {adv.linkText}
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 4. Pricing Section (4 Cards) -->
  <Pricing />

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 5. Node Coverage & Network Topology -->
  <section class="py-12 md:py-20 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <SectionHeader
      title="全球骨干机房 · 多路冗余网络"
      description="精选亚太与全球主流数据中心，全节点持续热备与动态调度，确保任何时刻都有最优连接"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
      {nodeGroups.map((node, i) => (
        <div
          class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex flex-col justify-between hover:shadow-md transition-all"
          data-aos="fade-up-xs"
          data-aos-delay={i * 70}
          data-aos-once="true"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <h4 class="text-base font-bold text-neutral-800 dark:text-neutral-100">{node.region}</h4>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-primary/10 text-primary font-medium">
                {node.tag}
              </span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4">
              {node.desc}
            </p>
          </div>
          <div class="pt-3 border-t border-dashed border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-xs">
            <span class="text-neutral-400">资源规模: <strong class="text-neutral-700 dark:text-neutral-200 font-semibold">{node.count}</strong></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">典型延迟: {node.latency}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <p class="text-xs text-neutral-500 dark:text-neutral-400">
        想了解专线数据转发原理？阅读技术专栏：<a href="/blog/iepl-network-architecture/" class="text-primary font-semibold hover:underline">《IEPL 专线网络架构与跨境低时延解析》</a>
      </p>
    </div>
  </section>

  <!-- 6. Onboarding Steps (使用流程) -->
  <section class="py-12 md:py-20 site-container bg-bg-secondary/40 dark:bg-bg-secondary-dark/40 rounded-3xl border border-primary/10 my-8">
    <SectionHeader
      title="4 步快速上手 · 开启高速旅程"
      description="流程简单明晰，从注册到连接仅需几分钟，全平台客户端让配置零门槛"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10 px-4 md:px-8">
      {steps.map((st, i) => (
        <div
          class="relative p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex flex-col justify-between"
          data-aos="fade-up-sm"
          data-aos-delay={i * 90}
          data-aos-once="true"
        >
          <div>
            <div class="text-3xl font-brand font-bold text-primary/30 mb-3">{st.step}</div>
            <h4 class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-2">{st.title}</h4>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-3">{st.desc}</p>
          </div>
          {st.guideLink && (
            <div class="pt-2 border-t border-dashed border-neutral-100 dark:border-neutral-800">
              <a href={st.guideLink} class="text-xs text-primary font-semibold hover:underline inline-flex items-center gap-1">
                {st.guideText} →
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <Button url={siteConfig.registerUrl} rel="nofollow sponsored" target="_blank" type="fill" className="px-8 py-3 mx-auto">
        立即开通账户使用 <ArrowRight class="w-4 h-4 ml-1.5" />
      </Button>
    </div>
  </section>

  <!-- 7. Real Business Scenarios (应用场景) -->
  <section class="py-12 md:py-20 site-container">
    <SectionHeader
      title="全面赋能高要求业务与个人场景"
      description="针对跨境办公、AI 模型研发、流媒体观影与跨境电商提供专属优化"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {useCases.map((uc, i) => (
        <div
          class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 hover:shadow-md transition-all flex flex-col justify-between"
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          <div class="flex items-start gap-4 mb-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
              <uc.icon class="w-5 h-5" />
            </div>
            <div>
              <h4 class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1.5">{uc.title}</h4>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">{uc.desc}</p>
            </div>
          </div>
          <div class="pt-2 border-t border-dashed border-neutral-100 dark:border-neutral-800 flex justify-end">
            <a href={uc.link} class="text-xs font-medium text-primary hover:underline">
              {uc.tag} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 8. FAQ Section -->
  <FAQ
    title="常见问题与技术支持"
    items={faqItems}
  />

  <!-- 9. SEO & Knowledge Base Entrance (4 篇权威技术指南矩阵) -->
  <div class="py-12 md:py-20">
    <BlogSection title="专线知识库与使用指南" />
  </div>

  <!-- 10. Final Brand CTA -->
  <section class="py-12 md:py-20 site-container rounded-3xl bg-gradient-to-b from-primary/10 via-primary/5 to-transparent border border-primary/20 my-8" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-3xl mx-auto text-center px-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-semibold mb-4">
        <ShieldCheck class="w-4 h-4" /> 2020 年稳定运营品牌保障
      </div>
      <h2 class="text-3xl md:text-4xl font-brand font-bold text-neutral-900 dark:text-neutral-50 mb-4">
        体验真正的企业级专线与 VLESS 协议
      </h2>
      <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed max-w-xl mx-auto">
        告别晚高峰卡顿、流媒体掉线与频繁封锁。立即注册加入 Nexitally，开启全专线低时延网络新体验。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button url={siteConfig.registerUrl} rel="nofollow sponsored" type="fill" className="text-base px-8 py-3.5" target="_blank">
          立即开通账号 <ArrowRight class="w-4 h-4 ml-1.5" />
        </Button>
