---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Clock3, LifeBuoy, Mail, MessageSquare, Send, Sparkles, ShieldCheck, Headphones } from "@lucide/astro";

const contactTopics = [
  { value: "custom", label: "企业定制版专线咨询 (680元/月独立部署)" },
  { value: "support", label: "专线使用与客户端配置协助" },
  { value: "sales", label: "大宗采购与长期年付咨询" },
  { value: "business", label: "商务合作与渠道联络" },
];

const channels = [
  {
    icon: Mail,
    label: "官方服务邮箱",
    text: siteConfig.mail,
    href: `mailto:${siteConfig.mail}`,
  },
  {
    icon: MessageSquare,
    label: "Telegram 官方频道",
    text: "@nexitally_channel",
    href: siteConfig.social.telegram,
  },
  {
    icon: Headphones,
    label: "用户工单系统",
    text: "登录控制台提交 7×24 工单",
    href: siteConfig.registerUrl,
  },
];

const expectations = [
  { icon: Clock3, title: "响应时效", desc: "专属工单与邮件通常在 1-4 小时内获得专业工程师回复。" },
  { icon: LifeBuoy, title: "技术协同", desc: "咨询客户端或节点时，附带您的客户端版本与节点名称处理更快速。" },
  { icon: ShieldCheck, title: "企业定制", desc: "定制版用户可申请 1 对 1 专属技术客服对接，协助梳理原生 IP 地区与带宽。" },
];
---

<Layout
  title="联系客服 — Nexitally 官方网站"
  description="联系 Nexitally 官方客服团队，咨询企业定制专线、客户端技术支持或反馈使用问题。"
  keywords="Nexitally客服, Nexitally联系方式, 专线技术支持"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] lg:items-start">
      <div data-aos="fade-up-xs" data-aos-once="true">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:border-primary-light/20 dark:bg-primary-light/10 dark:text-primary-light">
          <Sparkles size={14} />
          Official Support
        </p>
        <h1 class="max-w-xl font-brand text-4xl leading-tight tracking-normal text-neutral-800 dark:text-neutral-100 sm:text-5xl lg:text-6xl">
          随时为您的专线网络护航
        </h1>
        <p class="mt-5 max-w-lg text-sm md:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
          无论是日常使用答疑、客户端配置，还是企业定制专线规划，Nexitally 技术团队都竭诚为您提供稳定可靠的支持。
        </p>

        <!-- Channels -->
        <div class="mt-8 space-y-4">
          {channels.map((ch) => (
            <a
              href={ch.href}
              target="_blank"
              rel="nofollow sponsored"
              class="flex items-center gap-4 p-4 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700 hover:border-primary/40 transition-all hover:shadow-md"
            >
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                <ch.icon class="w-5 h-5" />
              </div>
              <div>
                <span class="block text-xs text-neutral-500">{ch.label}</span>
                <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{ch.text}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Expectations -->
        <div class="mt-8 space-y-3">
          {expectations.map((exp) => (
            <div class="flex items-start gap-3 text-xs text-neutral-500">
              <exp.icon class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
              <div>
                <strong class="text-neutral-700 dark:text-neutral-300 font-medium">{exp.title}：</strong>
                <span>{exp.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Action Card -->
      <div
        class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-8 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-once="true"
      >
        <h2 class="text-2xl font-bold font-brand text-neutral-800 dark:text-neutral-100 mb-2">
          在线工单快速通道
        </h2>
        <p class="text-xs text-neutral-500 mb-6">
          已注册用户建议直接通过用户控制台发起工单，系统将自动关联您的专线套餐与节点数据，处理效率更高。
        </p>

        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-900/60 border border-primary/10 text-xs space-y-2">
            <span class="font-semibold text-neutral-700 dark:text-neutral-300">常见直接处理渠道：</span>
            <ul class="list-disc list-inside space-y-1 text-neutral-500">
              <li>节点订阅链接无法更新或测速超时</li>
              <li>定制版 680 元/月独立专线与原生 IP 配置</li>
              <li>客户端下载校验与分流规则策略调整</li>
              <li>企业对公打款与发票收据开具</li>
            </ul>
          </div>

          <Button
            url={siteConfig.registerUrl}
            rel="nofollow sponsored"
            type="fill"
            target="_blank"
            className="w-full justify-center py-3.5 text-base shadow-lg shadow-primary/20"
          >
            登录官方控制台提交工单 <ArrowRight class="w-4 h-4 ml-1.5" />
          </Button>

          <Button
            url="/pricing"
            type="solid"
            className="w-full justify-center py-3 text-sm"
          >
            查看专线套餐资费说明
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
