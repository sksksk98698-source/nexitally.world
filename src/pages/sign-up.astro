---
import { ArrowRight, ShieldCheck, Zap, Globe2, CheckCircle2, Lock, Sparkles } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="注册开通 — Nexitally 官方网站"
  description="立即注册开通 Nexitally 官方专线账户，尊享企业级 IEPL / IPLC 专线低时延网络，全面解锁 AI 与 4K 流媒体。"
  robots="noindex, nofollow"
>
  <main class="site-container py-12 md:py-20">
    <section class="max-w-4xl mx-auto grid min-h-[calc(100vh-22rem)] items-center gap-8 lg:grid-cols-2">
      <!-- Left: Conversion Benefits -->
      <div data-aos="fade-right-xs" data-aos-once="true" class="space-y-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3">
            <Sparkles class="w-3.5 h-3.5" /> 官方授权注册通道
          </span>
          <h1 class="font-brand text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 leading-tight">
            开启极速低延迟<br />全球专线网络
          </h1>
          <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            加入自 2020 年稳定运营的 Nexitally 专线网络。全节点最高 2.5Gbps 物理专线，不限连接设备数量，开箱即用。
          </p>
        </div>

        <div class="space-y-3 text-xs md:text-sm text-neutral-700 dark:text-neutral-300">
          <div class="flex items-center gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 flex items-center justify-center flex-shrink-0">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <span>企业级物理 IEPL / IPLC 专线，晚高峰零卡顿</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 flex items-center justify-center flex-shrink-0">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <span>轻量低耗 VLESS 协议，原生支持抗干扰</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 flex items-center justify-center flex-shrink-0">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <span>全平台自研专属客户端 + Clash / Shadowrocket 订阅兼容</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 flex items-center justify-center flex-shrink-0">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <span>全系套餐不限设备数量，折合 8.25 元/月起</span>
          </div>
        </div>
      </div>

      <!-- Right: Action Card -->
      <div
        class="w-full max-w-md mx-auto"
        data-aos="fade-left-xs"
        data-aos-once="true"
      >
        <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-8 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 text-center">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
            <ShieldCheck class="w-7 h-7" />
          </div>

          <h2 class="text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-50 mb-2">
            前往官方控制台注册
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-8 leading-relaxed">
            点击下方专属通道直接跳转至 Nexitally 官方用户系统。开通后系统将自动下发节点订阅与专属客户端下载地址。
          </p>

          <Button
            url={siteConfig.registerUrl}
            rel="nofollow sponsored"
            type="fill"
            target="_blank"
            className="w-full justify-center text-base py-3.5 mb-4 shadow-lg shadow-primary/20"
          >
            直达官方授权注册通道 <ArrowRight class="w-4 h-4 ml-1.5" />
          </Button>

          <div class="text-xs text-neutral-400 dark:text-neutral-500 flex items-center justify-center gap-1.5 mt-4">
            <Lock class="w-3.5 h-3.5" />
            <span>SSL 企业级加密传输 · 账号安全受官方保护</span>
          </div>

          <div class="mt-6 pt-6 border-t border-dashed border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500">
            已有账号？
            <a href={siteConfig.registerUrl} target="_blank" rel="nofollow sponsored" class="text-primary font-medium hover:underline">
              直接前往登录
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
