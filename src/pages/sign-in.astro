---
import { ArrowRight, ShieldCheck, Lock, Sparkles, UserCheck } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="用户登录 — Nexitally 官方网站"
  description="登录 Nexitally 官方用户控制台，管理专线订阅、查看流量使用状态与下载客户端配置。"
  robots="noindex, nofollow"
>
  <main class="site-container py-12 md:py-20">
    <section class="max-w-md mx-auto min-h-[calc(100vh-22rem)] flex items-center justify-center">
      <div
        class="w-full rounded-3xl border border-primary/20 bg-bg-secondary/90 p-8 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 text-center"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="w-14 h-14 mx-auto rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
          <UserCheck class="w-7 h-7" />
        </div>

        <h1 class="text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-50 mb-2">
          登录 Nexitally 官方控制台
        </h1>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-8 leading-relaxed">
          管理您的订阅套餐、查看实时流量、获取最新 VLESS 节点配置或下载自研客户端。
        </p>

        <Button
          url={siteConfig.registerUrl}
          rel="nofollow sponsored"
          type="fill"
          target="_blank"
          className="w-full justify-center text-base py-3.5 mb-4 shadow-lg shadow-primary/20"
        >
          前往官方用户控制台 <ArrowRight class="w-4 h-4 ml-1.5" />
        </Button>

        <div class="text-xs text-neutral-400 dark:text-neutral-500 flex items-center justify-center gap-1.5 mt-4">
          <Lock class="w-3.5 h-3.5" />
          <span>官方加密会话保护 · 确保节点凭证安全</span>
        </div>

        <div class="mt-6 pt-6 border-t border-dashed border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500">
          还没有账户？
          <a href="/sign-up" class="text-primary font-medium hover:underline">
            立即注册新账号
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
